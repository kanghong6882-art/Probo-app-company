<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zenius Tech • Malaysia & Brunei Branch PROBO Orders</title>
    <meta name="theme-color" content="#1b365d">
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1180px;
            margin: 0 auto;
            background: #fff;
            padding: 25px 30px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .brand-tag {
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #1b365d;
            margin-bottom: 4px;
        }
        h1 {
            text-align: center;
            color: #1b365d;
            margin: 0 0 6px 0;
        }
        .subtitle {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-bottom: 16px;
        }
        .admin-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            padding: 12px 14px;
            margin-bottom: 12px;
            border-radius: 6px;
            background-color: #eef2f5;
            border: 1px solid #d5dde5;
        }
        .admin-status {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            font-size: 13px;
            font-weight: 600;
        }
        .branch-picker {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            padding: 5px 10px;
            border-radius: 6px;
            border: 1px solid #cbd5e0;
        }
        .branch-picker select {
            border: none;
            font-weight: 700;
            color: #1b365d;
            font-size: 13px;
            padding: 3px 6px;
            background: transparent;
            cursor: pointer;
        }
        .branch-info-strip {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 8px 14px;
            margin-bottom: 16px;
            font-size: 12.5px;
            color: #475569;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }
        .mode-pill {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
        }
        .mode-view { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
        .mode-branch { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .mode-host { background-color: #d1ecf1; color: #0c5460; border: 1px solid #bee5eb; }
        .db-status { font-size: 12px; color: #555; font-weight: 500; }
        .admin-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .btn-sm {
            padding: 6px 12px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .btn-unlock { background-color: #1b365d; color: #fff; }
        .btn-lock { background-color: #7f8c8d; color: #fff; }
        .btn-refresh { background-color: #2980b9; color: #fff; }
        .btn-pack { background-color: #d35400; color: #fff; }
        .btn-pack:hover { background-color: #a04000; }
        .btn-sheet {
            background-color: #1e8449;
            color: #fff;
            text-decoration: none;
            display: inline-block;
        }
        .admin-only-hidden { display: none !important; }
        .view-only-notice {
            text-align: center;
            padding: 10px;
            margin-bottom: 18px;
            background-color: #fff8e1;
            border: 1px solid #ffe082;
            border-radius: 6px;
            color: #6d4c00;
            font-size: 13px;
        }
        .packing-panel {
            background: #fffaf2;
            border: 2px solid #f39c12;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }
        .packing-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 12px;
        }
        .packing-header h3 { margin: 0; color: #b9770e; font-size: 16px; }
        .packing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 8px;
        }
        .pack-chip {
            background: #fff;
            border: 1px solid #fad7a0;
            border-radius: 6px;
            padding: 8px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
        }
        .pack-chip strong { color: #d35400; font-size: 15px; }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        .form-group { display: flex; flex-direction: column; }
        label { font-weight: 600; margin-bottom: 5px; font-size: 14px; }
        input, select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            background-color: #fff;
        }
        .status-btn {
            padding: 5px 10px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            white-space: nowrap;
        }
        .status-btn.readonly { cursor: default; opacity: 0.9; }
        .badge-paid { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .badge-unpaid { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .badge-topack { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
        .badge-packed { background-color: #d1ecf1; color: #0c5460; border: 1px solid #bee5eb; }
        .badge-done { background-color: #cce5ff; color: #004085; border: 1px solid #b8daff; }
        tr.row-done { background-color: #f0f9f4 !important; }
        .items-section {
            margin-bottom: 20px;
            padding: 18px;
            background-color: #f9fbfb;
            border: 1px solid #e1e8ed;
            border-radius: 6px;
        }
        .catalog-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }
        .category-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
        .tab-btn {
            padding: 8px 14px;
            border: 1px solid #cbd5e0;
            background-color: #fff;
            color: #1b365d;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }
        .tab-btn.active { background-color: #1b365d; color: #fff; border-color: #1b365d; }
        .search-box { flex: 1; min-width: 220px; max-width: 320px; }
        .search-box input { width: 100%; box-sizing: border-box; padding: 8px 12px; }
        .item-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 10px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .item-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            border: 1px solid #dce3e8;
            border-radius: 6px;
            padding: 10px 12px;
        }
        .item-card.selected { border-color: #2980b9; background-color: #eef7fc; }
        .item-info { display: flex; flex-direction: column; padding-right: 8px; }
        .item-badge { font-size: 10px; text-transform: uppercase; font-weight: 700; color: #7f8c8d; }
        .item-name { font-weight: 600; font-size: 14px; color: #2c3e50; margin-top: 2px; }
        .item-price { font-size: 13px; color: #16a085; font-weight: 600; margin-top: 2px; }
        .qty-controls { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
        .qty-btn {
            width: 30px;
            height: 30px;
            padding: 0;
            border: 1px solid #bbb;
            background-color: #f0f3f4;
            color: #2c3e50;
            font-size: 16px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
        }
        .qty-input {
            width: 48px;
            height: 30px;
            padding: 2px 4px;
            text-align: center;
            font-weight: 700;
            font-size: 14px;
            border: 1px solid #bbb;
            border-radius: 4px;
            box-sizing: border-box;
        }
        .custom-row { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-top: 15px; }
        .live-summary {
            margin-top: 16px;
            padding: 12px 16px;
            background-color: #1b365d;
            color: #fff;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .live-summary-items { font-size: 13px; color: #ecf0f1; flex: 1; }
        .live-summary-total { font-size: 18px; font-weight: 700; color: #2ecc71; white-space: nowrap; }
        .btn-group { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
        button.action-btn {
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-add { background-color: #2980b9; color: white; }
        .btn-export { background-color: #27ae60; color: white; }
        .btn-clear { background-color: #c0392b; color: white; margin-left: auto; }
        .table-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 8px;
        }
        .table-filters { display: flex; gap: 8px; flex-wrap: wrap; }
        .table-filters input, .table-filters select { padding: 7px 12px; font-size: 13px; }
        .table-wrapper { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 6px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 14px; }
        th { background-color: #1b365d; color: white; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        .delete-row-btn {
            background-color: #e74c3c;
            color: white;
            padding: 5px 10px;
            font-size: 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            align-items: center;
            justify-content: center;
            z-index: 999;
        }
        .modal-backdrop.open { display: flex; }
        .modal-box {
            background: #fff;
            padding: 24px;
            border-radius: 8px;
            width: 90%;
            max-width: 340px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
            text-align: center;
        }
        .modal-box h3 { margin-top: 0; color: #1b365d; }
        .modal-box input {
            width: 100%;
            box-sizing: border-box;
            text-align: center;
            font-size: 18px;
            letter-spacing: 4px;
            margin: 12px 0;
        }
        .modal-actions { display: flex; gap: 10px; justify-content: center; margin-top: 10px; }
    </style>
</head>
<body>

<div class="container">
    <div class="brand-tag">ZENIUS TECH • MALAYSIA & BRUNEI BRANCH NETWORK</div>
    <h1>PROBO Student Purchase Recording</h1>
    <div class="subtitle">Branch Order Collection → Live Sync to Kulai HQ Warehouse Packing</div>

    <div class="admin-bar">
        <div class="admin-status">
            <div class="branch-picker">
                <span>📍 Branch:</span>
                <select id="branchSelect" onchange="onBranchChanged()">
                    <option value="ALL" id="allBranchesOpt" disabled>🌐 ALL BRANCHES (Kulai HQ Master)</option>
                    <optgroup label="Johor (Malaysia)">
                        <option value="MY_Kulai_HQ">Kulai (Headquarters / Kulaijaya)</option>
                        <option value="MY_Bukit_Indah">Bukit Indah (Johor Bahru)</option>
                        <option value="MY_Taman_Gaya">Taman Gaya (Ulu Tiram)</option>
                        <option value="MY_Mutiara_Mas">Mutiara Mas (Skudai)</option>
                        <option value="MY_Simpang_Renggam">Simpang Renggam</option>
                        <option value="MY_Muar">Muar</option>
                        <option value="MY_Segamat">Segamat</option>
                    </optgroup>
                    <optgroup label="KL & Selangor (Malaysia)">
                        <option value="MY_Sri_Petaling">Sri Petaling (KL)</option>
                        <option value="MY_Kepong">Kepong (Taman Ehsan)</option>
                        <option value="MY_Bukit_Jelutong">Bukit Jelutong (Shah Alam)</option>
                        <option value="MY_Setia_Alam">Setia Alam (Shah Alam)</option>
                    </optgroup>
                    <optgroup label="Negeri Sembilan (Malaysia)">
                        <option value="MY_Seremban">Seremban (Oasis)</option>
                        <option value="MY_Bahau">Bahau</option>
                    </optgroup>
                    <optgroup label="Kedah & Sarawak (Malaysia)">
                        <option value="MY_Alor_Setar">Alor Setar (Kedah)</option>
                        <option value="MY_Miri">Miri (Sarawak)</option>
                    </optgroup>
                    <optgroup label="Brunei Darussalam">
                        <option value="BN_Gadong_Central">Gadong Central (BSB)</option>
                        <option value="BN_Kuala_Belait">Kuala Belait</option>
                        <option value="BN_Sengkurong">Sengkurong</option>
                    </optgroup>
                </select>
            </div>
            <span id="modeBadge" class="mode-pill mode-view">🔒 View-Only</span>
            <span id="dbStatusText" class="db-status">Connecting...</span>
        </div>
        <div class="admin-controls">
            <button type="button" id="togglePackBtn" class="btn-sm btn-pack admin-only-hidden" onclick="togglePackingPanel()">📦 HQ Packing List</button>
            <a id="openSheetBtn" href="https://docs.google.com/spreadsheets/d/1NlmOGPOW3e3ES_oO9AMwJtZZyS3-JEdLvkHHgolp7EM/edit?gid=0#gid=0" target="_blank" rel="noopener noreferrer" class="btn-sm btn-sheet admin-only-hidden">📊 Open Master Sheet</a>
            <button type="button" class="btn-sm btn-refresh" onclick="loadFromDatabase()">↻ Sync Now</button>
            <button type="button" id="unlockBtn" class="btn-sm btn-unlock" onclick="openPinModal()">Branch / Host Login</button>
            <button type="button" id="lockBtn" class="btn-sm btn-lock admin-only-hidden" onclick="lockAdmin()">Lock</button>
        </div>
    </div>

    <div class="branch-info-strip">
        <span id="branchAddressText">🏢 Shipping Address: -</span>
        <span id="branchCurrencyText">💱 Currency: RM</span>
    </div>

    <div id="packingPanel" class="packing-panel admin-only-hidden">
        <div class="packing-header">
            <h3 id="packingPanelTitle">📦 Warehouse Picking List (All "To Pack" Orders)</h3>
            <button type="button" class="btn-sm btn-export" onclick="exportPackingList()">Export Picking List (.xlsx)</button>
        </div>
        <div id="packingGrid" class="packing-grid"></div>
    </div>

    <div id="viewOnlyNotice" class="view-only-notice">
        Viewing live orders for <strong id="noticeBranchName">this branch</strong>. Log in with your <strong>Branch PIN</strong> to send student orders to Kulai HQ, or <strong>HQ Host PIN</strong> to pack orders.
    </div>

    <form id="recordForm" class="admin-only-hidden">
        <div class="form-grid">
            <div class="form-group" id="targetBranchFormGroup">
                <label for="orderBranchSelect">Order For Branch</label>
                <select id="orderBranchSelect" onchange="onOrderBranchSelectChange()"></select>
            </div>
            <div class="form-group">
                <label for="studentName">Student Name</label>
                <input type="text" id="studentName" placeholder="e.g., Ali Bin Ahmad" required>
            </div>
            <div class="form-group">
                <label for="paymentStatus">Payment Status</label>
                <select id="paymentStatus">
                    <option value="Unpaid">Unpaid</option>
                    <option value="Paid">Paid</option>
                </select>
            </div>
            <div class="form-group">
                <label for="recordDateTime">Date & Time</label>
                <input type="datetime-local" id="recordDateTime" required>
            </div>
        </div>

        <div class="items-section">
            <div class="catalog-controls">
                <div class="category-tabs">
                    <button type="button" class="tab-btn active" onclick="setCategory('All', this)">All (82)</button>
                    <button type="button" class="tab-btn" onclick="setCategory('Blocks', this)">Blocks (40)</button>
                    <button type="button" class="tab-btn" onclick="setCategory('Electronics & Others', this)">Electronics & Others (42)</button>
                    <button type="button" class="tab-btn" onclick="setCategory('Selected', this)">Selected Only</button>
                </div>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Search item name (e.g., Pintool, Motor, LED)..." oninput="renderCatalog()">
                </div>
            </div>

            <div class="item-list" id="itemList"></div>

            <div class="custom-row">
                <div class="form-group">
                    <label for="customItem">Other Item / Notes (Optional)</label>
                    <input type="text" id="customItem" placeholder="Enter any extra item or remarks" oninput="updateLiveSummary()">
                </div>
                <div class="form-group">
                    <label for="customPrice">Other Item Price (<span id="customCurrLabel">RM</span>)</label>
                    <input type="number" id="customPrice" step="0.10" min="0" placeholder="0.00" oninput="updateLiveSummary()">
                </div>
            </div>

            <div class="live-summary">
                <div class="live-summary-items" id="liveItemsText">No items selected</div>
                <div class="live-summary-total">Total: <span id="liveCurrLabel">RM</span> <span id="liveTotalAmount">0.00</span></div>
            </div>
        </div>

        <div class="btn-group">
            <button type="submit" id="submitRecordBtn" class="action-btn btn-add">+ Submit Branch Order to HQ</button>
            <button type="button" class="action-btn btn-export" onclick="exportToExcel()">Export Branch Excel</button>
            <button type="button" id="clearAllBtn" class="action-btn btn-clear admin-only-hidden" onclick="clearAllRecords()">Clear All Records (HQ Host)</button>
        </div>
    </form>

    <div id="publicBtnGroup" class="btn-group">
        <button type="button" class="action-btn btn-export" onclick="exportToExcel()">Export Branch Excel</button>
    </div>

    <div class="table-header-bar">
        <strong><span id="tableBranchTitle">Branch</span> Orders (<span id="recordCount">0</span>)</strong>
        <div class="table-filters">
            <select id="packFilter" onchange="renderTable()">
                <option value="ALL">All Packing Statuses</option>
                <option value="To Pack">⏳ To Pack Only</option>
                <option value="Packed">📦 Packed Only</option>
                <option value="Done">✓ Arrived / Done</option>
            </select>
            <input type="text" id="studentFilterInput" placeholder="Search student name..." oninput="renderTable()">
        </div>
    </div>

    <div class="table-wrapper">
        <table id="recordsTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Branch</th>
                    <th>Date & Time</th>
                    <th>Student Name</th>
                    <th>Items to Pack (Qty & Subtotal)</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>HQ Packing / Arrival</th>
                    <th>Updated By</th>
                    <th class="admin-col admin-only-hidden">Action</th>
                </tr>
            </thead>
            <tbody id="recordsBody"></tbody>
        </table>
    </div>
</div>

<div id="pinModal" class="modal-backdrop">
    <div class="modal-box">
        <h3 id="pinModalTitle">Branch Login</h3>
        <p id="pinModalSub" style="font-size: 13px; color: #666; margin: 0;">Enter your Branch PIN or Kulai HQ Host PIN.</p>
        <input type="password" id="pinInput" inputmode="numeric" placeholder="••••••" onkeydown="if(event.key==='Enter') submitPin()">
        <div id="pinError" style="color: #c0392b; font-size: 13px; min-height: 18px;"></div>
        <div class="modal-actions">
            <button type="button" class="btn-sm btn-unlock" id="pinSubmitBtn" onclick="submitPin()">Unlock</button>
            <button type="button" class="btn-sm btn-lock" onclick="closePinModal()">Cancel</button>
        </div>
    </div>
</div>

<script>
    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwP-X5u-lgVRuK0RDJZinatK9iAtUn-3ltni0bxCg6sJcCf4r0szeQcFe2qleBS9CPCvw/exec";

    const BRANCHES = {
        "MY_Kulai_HQ": { name: "Kulai (Headquarters / Kulaijaya)", currency: "RM", address: "No. 215A, Jalan Kenanga 29/2, Bandar Indahpura, 81000 Kulai, Johor" },
        "MY_Bukit_Indah": { name: "Bukit Indah (Johor Bahru)", currency: "RM", address: "No. 18A, Jalan Indah 15/3, Taman Bukit Indah, 81200 Johor Bahru, Johor" },
        "MY_Taman_Gaya": { name: "Taman Gaya (Ulu Tiram)", currency: "RM", address: "No. 22A, Jalan Gaya 1, Taman Gaya, 81800 Ulu Tiram, Johor" },
        "MY_Mutiara_Mas": { name: "Mutiara Mas (Skudai)", currency: "RM", address: "No. 33A, Jalan Mutiara 1/2, Taman Mutiara Mas, 81300 Skudai, Johor" },
        "MY_Simpang_Renggam": { name: "Simpang Renggam", currency: "RM", address: "No. 12A, Jalan Kijang, Taman Mohd Yassin, 86200 Simpang Renggam, Johor" },
        "MY_Muar": { name: "Muar", currency: "RM", address: "No. 45A, Jalan Perniagaan Jaya, Pusat Perniagaan Mas Jaya, 84000 Muar, Johor" },
        "MY_Segamat": { name: "Segamat", currency: "RM", address: "No. 19A, Jalan Utama 3/4, Pusat Komersial Sri Utama, 85000 Segamat, Johor" },
        "MY_Sri_Petaling": { name: "Sri Petaling (KL)", currency: "RM", address: "No. 88-1, Jalan Radin Bagus, Bandar Baru Sri Petaling, 57000 Kuala Lumpur" },
        "MY_Kepong": { name: "Kepong (Taman Ehsan)", currency: "RM", address: "No. 15A, Jalan Ehsan Utama, Taman Ehsan, 52100 Kepong, Kuala Lumpur" },
        "MY_Bukit_Jelutong": { name: "Bukit Jelutong (Shah Alam)", currency: "RM", address: "No. 24A, Jalan Bazar U8/99, Bukit Jelutong, 40150 Shah Alam, Selangor" },
