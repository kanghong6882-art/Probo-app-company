                : '';
            card.innerHTML = `
                <div class="item-info">
                    <span class="item-badge">${item.category}</span>
                    <span class="item-name">${item.name}</span>
                    <span class="item-price">${priceLabel}</span>
                </div>
                <div class="qty-controls">
                    <button type="button" class="qty-btn" onclick="changeQty('${item.id}', -1)">−</button>
                    <input type="number" class="qty-input" id="qty_${item.id}" min="0" value="${qty}" oninput="setQty('${item.id}', this.value)" onfocus="this.select()">
                    <button type="button" class="qty-btn" onclick="changeQty('${item.id}', 1)">+</button>
                    ${packBtn}
                </div>
            `;
            itemList.appendChild(card);
        });
    }

    function changeQty(itemId, delta) {
        const newQty = Math.max(0, (quantities[itemId] || 0) + delta);
        quantities[itemId] = newQty;
        const inputEl = document.getElementById(`qty_${itemId}`);
        const cardEl = document.getElementById(`card_${itemId}`);
        if (inputEl) inputEl.value = newQty;
        if (cardEl) cardEl.classList.toggle('selected', newQty > 0);
        if (activeCategory === 'Selected' && newQty === 0) renderCatalog();
        updateLiveSummary();
    }

    function setQty(itemId, rawValue) {
        const parsed = parseInt(rawValue, 10);
        const newQty = isNaN(parsed) || parsed < 0 ? 0 : parsed;
        quantities[itemId] = newQty;
        const cardEl = document.getElementById(`card_${itemId}`);
        if (cardEl) cardEl.classList.toggle('selected', newQty > 0);
        updateLiveSummary();
    }

    function buildSelectionSummary() {
        const curr = getFormCurrency();
        let parts = [];
        let total = 0;

        catalog.forEach(item => {
            const qty = quantities[item.id] || 0;
            if (qty > 0) {
                const sub = calcSubtotal(qty, item.price);
                total = Math.round((total + sub) * 100) / 100;
                parts.push(`${item.name} x${qty} (${curr} ${sub.toFixed(2)})`);
            }
        });

        const customItem = document.getElementById('customItem').value.trim();
        const customPrice = parseFloat(document.getElementById('customPrice').value) || 0;
        if (customItem || customPrice > 0) {
            const label = customItem || 'Other Item';
            total = Math.round((total + customPrice) * 100) / 100;
            parts.push(`${label} (${curr} ${customPrice.toFixed(2)})`);
        }

        return { parts, total };
    }

    function updateLiveSummary() {
        const { parts, total } = buildSelectionSummary();
        document.getElementById('liveItemsText').textContent =
            parts.length > 0 ? parts.join(' | ') : 'No items selected';
        document.getElementById('liveTotalAmount').textContent = total.toFixed(2);
    }

    function setCurrentDateTime() {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        document.getElementById('recordDateTime').value = now.toISOString().slice(0, 16);
    }

    function formatDateTimes(rec) {
        if (rec.dateTimes && rec.dateTimes.length > 0) {
            return rec.dateTimes.map(dt => dt.replace('T', ' ')).join(' | ');
        }
        return (rec.dateTime || '').replace('T', ' ');
    }

    async function togglePayment(index) {
        if (userRole === 'view') return;
        const rec = records[index];
        const nextStatus = (rec.paymentStatus === 'Paid') ? 'Unpaid' : 'Paid';
        rec.paymentStatus = nextStatus;
        renderTable();
        await postAction({
            action: 'updateStatus',
            branchKey: rec.branchKey,
            studentName: rec.studentName,
            paymentStatus: nextStatus
        });
    }

    async function cyclePackingStatus(index) {
        if (userRole === 'view') return;
        const rec = records[index];
        const cur = rec.packingStatus || 'To Pack';
        let next = 'Packed';
        if (cur === 'To Pack') next = 'Packed';
        else if (cur === 'Packed') next = 'Done';
        else next = 'To Pack';

        rec.packingStatus = next;
        renderTable();
        if (showPacking) renderPackingSummary();
        await postAction({
            action: 'updateStatus',
            branchKey: rec.branchKey,
            studentName: rec.studentName,
            packingStatus: next
        });
    }

    function renderTable() {
        const tbody = document.getElementById('recordsBody');
        const studentFilter = (document.getElementById('studentFilterInput').value || '').trim().toLowerCase();
        const packFilter = document.getElementById('packFilter').value;
        const canEdit = (userRole === 'branch' || userRole === 'host');
        tbody.innerHTML = '';

        let visibleCount = 0;

        records.forEach((rec, index) => {
            const pStatus = rec.packingStatus || 'To Pack';
            if (packFilter !== 'ALL' && pStatus !== packFilter) return;
            if (studentFilter && !rec.studentName.toLowerCase().includes(studentFilter)) return;
            visibleCount++;

            const isPaid = (rec.paymentStatus || 'Unpaid') === 'Paid';
            const isDone = (pStatus === 'Done');
            const curr = rec.currency || 'RM';

            const row = document.createElement('tr');
            if (isDone) row.className = 'row-done';

            let packBadgeClass = 'badge-topack';
            let packLabel = '⏳ To Pack';
            if (pStatus === 'Packed') { packBadgeClass = 'badge-packed'; packLabel = '📦 Packed'; }
            if (pStatus === 'Done') { packBadgeClass = 'badge-done'; packLabel = '✓ Arrived / Done'; }

            const paymentHtml = canEdit
                ? `<button type="button" class="status-btn ${isPaid ? 'badge-paid' : 'badge-unpaid'}" onclick="togglePayment(${index})">${isPaid ? 'Paid' : 'Unpaid'}</button>`
                : `<span class="status-btn readonly ${isPaid ? 'badge-paid' : 'badge-unpaid'}">${isPaid ? 'Paid' : 'Unpaid'}</span>`;

            const packingHtml = canEdit
                ? `<button type="button" class="status-btn ${packBadgeClass}" onclick="cyclePackingStatus(${index})" title="Click to advance: To Pack → Packed → Done">${packLabel}</button>`
                : `<span class="status-btn readonly ${packBadgeClass}">${packLabel}</span>`;

            const actionCellHtml = canEdit
                ? `<td><button class="delete-row-btn" onclick="deleteRecord(${index})">Delete</button></td>`
                : ``;

            row.innerHTML = `
                <td>${visibleCount}</td>
                <td><strong>${rec.branchName || rec.branchKey}</strong></td>
                <td>${formatDateTimes(rec)}</td>
                <td>${rec.studentName}</td>
                <td>${rec.itemsSummary || ''}</td>
                <td>${curr} ${Number(rec.total || 0).toFixed(2)}</td>
                <td>${paymentHtml}</td>
                <td>${packingHtml}</td>
                <td style="font-size:12px;color:#555;">${rec.updatedBy || '-'}</td>
                ${actionCellHtml}
            `;
            tbody.appendChild(row);
        });

        document.getElementById('recordCount').textContent = visibleCount;
    }

    function resetQuantities() {
        catalog.forEach(item => quantities[item.id] = 0);
        document.getElementById('searchInput').value = '';
        renderCatalog();
        updateLiveSummary();
    }

    document.getElementById('recordForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        if (userRole === 'view') return;

        const targetBranch = (userRole === 'host')
            ? document.getElementById('orderBranchSelect').value
            : getActiveBranchKey();
        const studentName = document.getElementById('studentName').value.trim();
        const paymentStatus = document.getElementById('paymentStatus').value;
        const dateTime = document.getElementById('recordDateTime').value;
        const { parts, total } = buildSelectionSummary();

        if (parts.length === 0) {
            alert('Please select at least one item quantity or enter a custom item.');
            return;
        }

        const btn = document.getElementById('submitRecordBtn');
        btn.disabled = true;
        btn.textContent = 'Sending to Kulai HQ...';

        const ok = await postAction({
            action: 'addPurchase',
            branchKey: targetBranch,
            studentName: studentName,
            dateTime: dateTime,
            itemsSummary: parts.join(', '),
            addedTotal: total,
            paymentStatus: paymentStatus
        });

        btn.disabled = false;
        btn.textContent = '+ Submit Branch Order to HQ';

        if (ok) {
            document.getElementById('studentName').value = '';
            document.getElementById('customItem').value = '';
            document.getElementById('customPrice').value = '';
            resetQuantities();
            setCurrentDateTime();
        }
    });

    async function deleteRecord(index) {
        if (userRole === 'view') return;
        const rec = records[index];
        if (!confirm(`Delete record for ${rec.studentName} (${rec.branchName})?`)) return;
        await postAction({
            action: 'deleteRow',
            branchKey: rec.branchKey,
            studentName: rec.studentName
        });
    }

    async function clearAllRecords() {
        if (userRole !== 'host') return;
        if (confirm('Clear ALL branch records from the Kulai HQ Master Sheet? This cannot be undone.')) {
            await postAction({ action: 'clearAll', branchKey: 'ALL' });
        }
    }

    function exportToExcel() {
        if (records.length === 0) {
            alert('No records available to export.');
            return;
        }
        const excelData = records.map((rec, index) => ({
            'No.': index + 1,
            'Branch': rec.branchName || rec.branchKey,
            'Date & Time': formatDateTimes(rec),
            'Student Name': rec.studentName,
            'Items Purchased': rec.itemsSummary || '',
            'Currency': rec.currency || 'RM',
            'Total Amount': rec.total,
            'Payment Status': rec.paymentStatus || 'Unpaid',
            'Packing Status': rec.packingStatus || 'To Pack',
            'Updated By': rec.updatedBy || ''
        }));

        const worksheet = XLSX.utils.json_to_sheet(excelData);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, 'Branch_Orders');
        const fileTag = getActiveBranchKey();
        XLSX.writeFile(workbook, `ZeniusTech_PROBO_${fileTag}.xlsx`);
    }

    function exportPackingList() {
        const items = computePickingList();
        if (items.length === 0) {
            alert('No "To Pack" items to export.');
            return;
        }
        const sheetRows = items.map(([name, qty], i) => ({
            'No.': i + 1,
            'PROBO Item Name': name,
            'Total Quantity to Pick': qty,
            'Packed Check': '[   ]'
        }));
        const ws = XLSX.utils.json_to_sheet(sheetRows);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'HQ_Picking_List');
        XLSX.writeFile(wb, `Kulai_HQ_Picking_List_${getActiveBranchKey()}.xlsx`);
    }

    initBranchDropdowns();
    setCurrentDateTime();
    applyRoleUI();
    loadFromDatabase();

    setInterval(() => {
        if (!document.hidden && !isSaving) {
            loadFromDatabase(true);
        }
    }, 15000);
</script>

</body>
</html>
