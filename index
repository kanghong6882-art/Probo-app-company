    async function loadFromDatabase(silent = false) {
        if (isSaving) return;
        const bKey = getActiveBranchKey();
        if (!silent) setDbStatus('Syncing with HQ Sheet...');

        try {
            const url = `${GOOGLE_SCRIPT_URL}?action=list&branchKey=${encodeURIComponent(bKey)}&_t=${Date.now()}`;
            const res = await fetch(url);
            const data = await res.json();
            if (data.ok && Array.isArray(data.records)) {
                records = data.records;
                const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                setDbStatus(`✓ Live (${nowStr})`);
                renderTable();
                if (showPacking) renderPackingSummary();
            } else {
                setDbStatus('⚠ Could not read HQ Sheet');
            }
        } catch (err) {
            setDbStatus('Offline (Retrying...)');
        }
    }

    async function postAction(payload) {
        isSaving = true;
        setDbStatus('Saving to HQ Sheet...');
        try {
            const res = await fetch(GOOGLE_SCRIPT_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({
                    ...payload,
                    pin: authPin
                })
            });
            const data = await res.json();
            if (!data.ok) {
                alert(data.message || 'Authorization failed.');
                lockAdmin();
            }
            isSaving = false;
            await loadFromDatabase();
            return data.ok;
        } catch (err) {
            isSaving = false;
            alert('Network error. Please check internet connection.');
            return false;
        }
    }

