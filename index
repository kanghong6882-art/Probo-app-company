    async function submitPin() {
        const entered = document.getElementById('pinInput').value.trim();
        const bKey = getActiveBranchKey();
        const errorEl = document.getElementById('pinError');
        const btn = document.getElementById('pinSubmitBtn');

        if (!entered) {
            errorEl.textContent = 'Please enter your PIN.';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Checking...';
        errorEl.textContent = '';

        try {
            const url = `${GOOGLE_SCRIPT_URL}?action=verifyPin&branchKey=${encodeURIComponent(bKey)}&pin=${encodeURIComponent(entered)}`;
            const res = await fetch(url);
            const data = await res.json();
            if (data.ok) {
                authPin = entered;
                userRole = data.role;
                staffName = data.staffName;
                loggedInBranch = data.branchKey;
                sessionStorage.setItem('ztBranchPin', authPin);
                sessionStorage.setItem('ztBranchRole', userRole);
                sessionStorage.setItem('ztBranchStaffName', staffName);
                sessionStorage.setItem('ztBranchKey', loggedInBranch);
                closePinModal();
                applyRoleUI();
                if (userRole === 'host') {
                    document.getElementById('branchSelect').value = 'ALL';
                    updateBranchHeaderUI();
                    loadFromDatabase();
                }
            } else {
                errorEl.textContent = data.message || 'Invalid PIN for this branch.';
            }
        } catch (err) {
            errorEl.textContent = 'Network error checking PIN. Please try again.';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Unlock';
        }
    }

