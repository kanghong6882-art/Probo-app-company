    function computePickingList() {
        const totals = {};
        records.forEach(rec => {
            if ((rec.packingStatus || 'To Pack') !== 'To Pack') return;
            const summary = rec.itemsSummary || '';
            summary.split(', ').forEach(part => {
                const m = part.match(/^(.+?)\s+x(\d+)\s+\(/);
                if (m) {
                    const itemName = m[1].trim();
                    const qty = parseInt(m[2], 10) || 0;
                    totals[itemName] = (totals[itemName] || 0) + qty;
                } else if (part.trim()) {
                    totals[part.trim()] = (totals[part.trim()] || 0) + 1;
                }
            });
        });
        return Object.entries(totals).sort((a, b) => b[1] - a[1]);
    }

